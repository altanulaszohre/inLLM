    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^5.4.394",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.13.0",
    "zod": "^4.1.12"
